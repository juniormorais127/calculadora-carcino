rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function verifiedOwner(uid) { return owner(uid) && request.auth.token.email_verified == true; }
    function primarySenior(uid) { return uid == 'Dc2sEKML8Lc66cgj8VvSX4Uhhpk1'; }
    function profileRole(uid) {
      return exists(/databases/$(database)/documents/accountProfiles/$(uid))
        ? get(/databases/$(database)/documents/accountProfiles/$(uid)).data.get('role', 'producer') : 'producer';
    }
    function senior() { return request.auth != null && request.auth.token.email_verified == true && (primarySenior(request.auth.uid) || profileRole(request.auth.uid) == 'senior'); }
    function admin() { return request.auth != null && request.auth.token.email_verified == true && (senior() || profileRole(request.auth.uid) == 'administrator'); }
    function supportAuditor() { return request.auth != null && request.auth.token.email_verified == true && (admin() || get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.get('canAuthorizeTechnicalSupport', false) == true); }
    function propertyKey(name) {
      return name.lower().replace('[áàâãä]', 'a').replace('[éèêë]', 'e').replace('[íìîï]', 'i').replace('[óòôõö]', 'o').replace('[úùûü]', 'u').replace('ç', 'c').replace('ñ', 'n').replace('[^a-z0-9]+', '-').replace('^-|-$', '');
    }
    match /propertyNames/{key} {
      allow get: if request.auth != null && request.auth.token.email_verified == true;
      function validReservation() {
        return request.resource.data.keys().hasOnly(['source', 'sourceId', 'ownerUid']) && key.size() >= 2 && key.size() <= 200
          && ((request.resource.data.source == 'farm' && (verifiedOwner(request.resource.data.sourceId) || admin())
            && request.resource.data.ownerUid == request.resource.data.sourceId
            && propertyKey(getAfter(/databases/$(database)/documents/fieldFarms/$(request.resource.data.sourceId)).data.name) == key)
          || (request.resource.data.source == 'assisted' && identifiedFieldTech() && request.resource.data.ownerUid == null
            && getAfter(/databases/$(database)/documents/assistedProducers/$(request.resource.data.sourceId)).data.technicianUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/assistedProducers/$(request.resource.data.sourceId)).data.propertyKey == key));
      }
      allow create: if validReservation();
      allow update: if (validReservation() && resource.data.source == 'assisted' && request.resource.data.source == 'assisted'
          && get(/databases/$(database)/documents/assistedProducers/$(resource.data.sourceId)).data.auditStatus == 'rejected'
          && get(/databases/$(database)/documents/assistedProducers/$(resource.data.sourceId)).data.technicianUid == request.auth.uid)
        || (request.auth != null && request.auth.token.email_verified == true && resource.data.source == 'assisted' && resource.data.ownerUid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid']) && request.resource.data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/assistedProducers/$(resource.data.sourceId)).data.ownerUid == request.auth.uid);
    }
    match /accountProfiles/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      function validProfile() {
        return request.resource.data.keys().hasOnly(['email', 'createdAt', 'lastSeenAt', 'premium', 'expiresAt', 'changedBy', 'changedAt', 'role', 'phone', 'fullName', 'canAuthorizeTechnicalSupport'])
          && (!('canAuthorizeTechnicalSupport' in request.resource.data) || request.resource.data.canAuthorizeTechnicalSupport is bool)
          && (!('fullName' in request.resource.data) || request.resource.data.fullName == getAfter(/databases/$(database)/documents/accountNames/$(uid)).data.fullName)
          && request.resource.data.get('role', 'producer') in ['producer', 'field_technician', 'administrator', 'senior']
          && (!primarySenior(uid) || request.resource.data.get('role', 'producer') == 'senior')
          && request.resource.data.email is string && request.resource.data.email.size() <= 320
          && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.matches('^[+][1-9][0-9]{7,14}$')))
          && request.resource.data.premium is bool
          && (request.resource.data.expiresAt == null || request.resource.data.expiresAt is timestamp);
      }
      allow create: if (senior() && !primarySenior(uid) && validProfile()
        && request.resource.data.role in ['administrator', 'field_technician', 'producer']
        && request.resource.data.createdAt == request.time && request.resource.data.changedAt == request.time && request.resource.data.changedBy == request.auth.uid)
        || (owner(uid) && validProfile()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time && request.resource.data.lastSeenAt == request.time
        && request.resource.data.premium == false && request.resource.data.expiresAt == null
        && request.resource.data.get('canAuthorizeTechnicalSupport', false) == false
        && (request.resource.data.get('role', 'producer') == 'producer' || (primarySenior(uid) && request.resource.data.role == 'senior'))
        && request.resource.data.changedBy == null && request.resource.data.changedAt == null);
      allow update: if validProfile() && (
        (owner(uid) && !('fullName' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName']))
        ||
        (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone']) && request.resource.data.phone is string)
        || ((senior() || (admin() && !primarySenior(uid) && resource.data.get('role', 'producer') in ['producer', 'field_technician']))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'changedBy', 'changedAt'])
          && request.resource.data.phone is string
          && request.resource.data.changedBy == request.auth.uid && request.resource.data.changedAt == request.time)
        || (owner(uid) && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'lastSeenAt'])
          || (!('role' in resource.data) && request.resource.data.role == 'producer'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'lastSeenAt', 'role']))
          || (primarySenior(uid) && request.resource.data.role == 'senior'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'lastSeenAt', 'role'])))
          && request.resource.data.email == request.auth.token.email && request.resource.data.lastSeenAt == request.time)
        || ((senior() || (admin() && !primarySenior(uid)
              && resource.data.get('role', 'producer') in ['producer', 'field_technician']
              && request.resource.data.role in ['producer', 'field_technician']))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['premium', 'expiresAt', 'changedBy', 'changedAt', 'role', 'canAuthorizeTechnicalSupport'])
          && request.resource.data.changedBy == request.auth.uid && request.resource.data.changedAt == request.time));
      allow delete: if owner(uid) || (senior() && !primarySenior(uid));
    }
    match /accountNames/{uid} {
      allow get: if owner(uid) || admin();
      allow create: if (owner(uid) || senior()) && request.resource.data.keys().hasOnly(['fullName', 'createdAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 5 && request.resource.data.fullName.size() <= 800 && request.resource.data.fullName.matches('^.+ .+$')
        && request.resource.data.createdAt == request.time;
    }
    match /purchaseEvents/{eventId} {
      allow get: if admin() || (request.auth != null && (!exists(/databases/$(database)/documents/purchaseEvents/$(eventId)) || resource.data.uid == request.auth.uid));
      allow list: if admin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'targetId', 'targetName', 'category', 'occurredAt', 'receivedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['view', 'brand', 'whatsapp', 'phone', 'product']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 120
        && request.resource.data.targetName is string && request.resource.data.targetName.size() <= 200
        && request.resource.data.category is string && request.resource.data.category.size() <= 100
        && request.resource.data.occurredAt is int && request.resource.data.occurredAt > 0
        && request.resource.data.occurredAt <= request.time.toMillis() + 300000
        && request.resource.data.receivedAt == request.time;
      allow delete: if senior() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    function fieldTech() { return request.auth != null && request.auth.token.email_verified == true && profileRole(request.auth.uid) == 'field_technician'; }
    function identifiedFieldTech() { return fieldTech() && exists(/databases/$(database)/documents/technicianIdentities/$(request.auth.uid))
      && get(/databases/$(database)/documents/technicianIdentities/$(request.auth.uid)).data.get('employmentType', '') in ['private', 'organization']
      && get(/databases/$(database)/documents/technicianIdentities/$(request.auth.uid)).data.fullName == get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.fullName; }
    match /technicianIdentities/{uid} {
      allow get: if request.auth != null;
      allow list: if admin();
      allow create, update: if owner(uid) && fieldTech()
        && request.resource.data.keys().hasOnly(['fullName', 'creaNumber', 'photoDataUrl', 'employmentType', 'organizationName', 'updatedAt'])
        && request.resource.data.employmentType in ['private', 'organization'] && request.resource.data.organizationName is string
        && ((request.resource.data.employmentType == 'private' && request.resource.data.organizationName == '') || (request.resource.data.employmentType == 'organization' && request.resource.data.organizationName.size() >= 2 && request.resource.data.organizationName.size() <= 800))
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 5 && request.resource.data.fullName.size() <= 800 && request.resource.data.fullName.matches('^.+ .+$')
        && request.resource.data.fullName == get(/databases/$(database)/documents/accountProfiles/$(uid)).data.fullName
        && request.resource.data.creaNumber is string && (request.resource.data.creaNumber == '' || request.resource.data.creaNumber.size() >= 3) && request.resource.data.creaNumber.size() <= 320
        && request.resource.data.photoDataUrl is string && request.resource.data.photoDataUrl.size() <= 100000 && request.resource.data.photoDataUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner(uid);
    }
    function fieldAccess(uid) {
      return fieldTech() && exists(/databases/$(database)/documents/fieldAuthorizations/$(uid + '~' + request.auth.uid))
        && get(/databases/$(database)/documents/fieldAuthorizations/$(uid + '~' + request.auth.uid)).data.active == true;
    }
    match /fieldAuthorizations/{id} {
      allow get: if request.auth != null && (!exists(/databases/$(database)/documents/fieldAuthorizations/$(id)) || resource.data.ownerUid == request.auth.uid || resource.data.technicianUid == request.auth.uid || supportAuditor());
      allow list: if request.auth != null && (resource.data.ownerUid == request.auth.uid || resource.data.technicianUid == request.auth.uid || supportAuditor());
      function validRequest() {
        return request.resource.data.keys().hasOnly(['ownerUid', 'technicianUid', 'assistedId', 'active', 'status', 'requestNote', 'requestedBy', 'requestedAt', 'auditNote', 'auditName', 'auditedBy', 'auditedAt', 'changedBy', 'changedAt', 'eventId'])
        && request.resource.data.ownerUid is string && request.resource.data.technicianUid is string
        && id == request.resource.data.ownerUid + '~' + request.resource.data.technicianUid
        && request.resource.data.ownerUid != request.resource.data.technicianUid
        && (verifiedOwner(request.resource.data.ownerUid) || admin() || (identifiedFieldTech() && request.resource.data.technicianUid == request.auth.uid
          && ((request.resource.data.assistedId is string && get(/databases/$(database)/documents/assistedProducers/$(request.resource.data.assistedId)).data.ownerUid == request.resource.data.ownerUid && get(/databases/$(database)/documents/assistedProducers/$(request.resource.data.assistedId)).data.technicianUid == request.auth.uid)
            || (exists(/databases/$(database)/documents/fieldAuthorizations/$(id)) && resource.data.technicianUid == request.auth.uid && resource.data.ownerUid == request.resource.data.ownerUid))))
        && profileRole(request.resource.data.technicianUid) == 'field_technician'
        && request.resource.data.active == false && request.resource.data.status == 'pending'
        && request.resource.data.requestNote is string && request.resource.data.requestNote.size() >= 10 && request.resource.data.requestNote.size() <= 8000
        && request.resource.data.requestedBy == request.auth.uid && request.resource.data.requestedAt == request.time
        && request.resource.data.auditNote == '' && request.resource.data.auditName == '' && request.resource.data.auditedBy == null && request.resource.data.auditedAt == null
        && request.resource.data.changedBy == request.auth.uid && request.resource.data.changedAt == request.time
        && getAfter(/databases/$(database)/documents/fieldAuthorizations/$(id)/history/$(request.resource.data.eventId)).data.status == 'pending';
      }
      allow create: if validRequest();
      allow update: if (validRequest() && resource.data.active == false && resource.data.get('status', '') != 'pending' && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.technicianUid == resource.data.technicianUid)
        || (request.auth != null && request.auth.token.email_verified == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'status', 'auditNote', 'auditName', 'auditedBy', 'auditedAt', 'changedBy', 'changedAt', 'eventId'])
          && ((supportAuditor() && request.auth.uid != resource.data.technicianUid && request.auth.uid != resource.data.get('requestedBy', '') && resource.data.get('status', '') == 'pending' && request.resource.data.status in ['approved', 'rejected', 'changes_requested'])
            || ((verifiedOwner(resource.data.ownerUid) || supportAuditor()) && request.resource.data.status == 'revoked'))
          && request.resource.data.active == (request.resource.data.status == 'approved')
          && (!request.resource.data.active || profileRole(resource.data.technicianUid) == 'field_technician')
          && request.resource.data.auditNote is string && request.resource.data.auditNote.size() >= 10 && request.resource.data.auditNote.size() <= 8000
          && request.resource.data.auditName == get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.get('fullName', '')
          && request.resource.data.auditedBy == request.auth.uid && request.resource.data.auditedAt == request.time && request.resource.data.changedBy == request.auth.uid && request.resource.data.changedAt == request.time
          && getAfter(/databases/$(database)/documents/fieldAuthorizations/$(id)/history/$(request.resource.data.eventId)).data.status == request.resource.data.status);
      match /history/{eventId} {
        function authorization() { return get(/databases/$(database)/documents/fieldAuthorizations/$(id)).data; }
        allow read: if request.auth != null && (authorization().ownerUid == request.auth.uid || authorization().technicianUid == request.auth.uid || supportAuditor());
        allow create: if request.auth != null && request.resource.data.keys().hasOnly(['status', 'note', 'by', 'at']) && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/fieldAuthorizations/$(id)).data.eventId == eventId
          && getAfter(/databases/$(database)/documents/fieldAuthorizations/$(id)).data.status == request.resource.data.status
          && getAfter(/databases/$(database)/documents/fieldAuthorizations/$(id)).data.changedBy == request.auth.uid
          && (request.resource.data.note == getAfter(/databases/$(database)/documents/fieldAuthorizations/$(id)).data.auditNote || request.resource.data.note == getAfter(/databases/$(database)/documents/fieldAuthorizations/$(id)).data.requestNote);
      }
    }
    match /fieldFarms/{uid} {
      allow delete: if owner(uid);
      allow list: if admin();
      allow get: if verifiedOwner(uid) || fieldAccess(uid) || admin();
      allow create, update: if verifiedOwner(uid) && request.resource.data.keys().hasOnly(['ownerUid', 'ownerEmail', 'name', 'ponds', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/propertyNames/$(propertyKey(request.resource.data.name))).data.ownerUid == uid
        && (!('ownerEmail' in request.resource.data) || request.resource.data.ownerEmail == request.auth.token.email.lower())
        && request.resource.data.ownerUid == uid && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 200
        && request.resource.data.ponds is list && request.resource.data.ponds.size() <= 2000 && request.resource.data.updatedAt == request.time;
    }
    match /propertyDirectory/{uid} {
      allow get: if owner(uid) || identifiedFieldTech() || admin();
      allow list: if admin() || (identifiedFieldTech() && request.query.limit != null && request.query.limit <= 8);
      allow create, update: if (verifiedOwner(uid) || admin()) && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'nameSearch', 'updatedAt'])
        && request.resource.data.ownerUid == uid && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 800
        && request.resource.data.nameSearch is string && request.resource.data.nameSearch.size() > 0 && request.resource.data.nameSearch.size() <= 800
        && request.resource.data.name == getAfter(/databases/$(database)/documents/fieldFarms/$(uid)).data.name && request.resource.data.updatedAt == request.time;
      allow delete: if owner(uid);
    }
    match /technicalVisits/{id} {
      allow delete: if admin();
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || (fieldTech() && resource.data.technicianUid == request.auth.uid) || admin());
      allow create: if identifiedFieldTech() && request.resource.data.technicianUid == request.auth.uid && fieldAccess(request.resource.data.ownerUid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'technicianUid', 'technicianEmail', 'farmName', 'pondId', 'pondName', 'visitedOn', 'summary', 'correctLocation', 'latitude', 'longitude', 'previousLatitude', 'previousLongitude', 'licenseStatus', 'licenseNumber', 'licenseRegisteredOn', 'licenseExpiresOn', 'status', 'createdAt', 'decidedAt'])
        && request.resource.data.technicianEmail == request.auth.token.email
        && request.resource.data.farmName is string && request.resource.data.farmName.size() <= 200
        && request.resource.data.pondId is int && request.resource.data.pondId > 0 && request.resource.data.pondName is string && request.resource.data.pondName.size() <= 200
        && request.resource.data.summary is string && request.resource.data.summary.size() >= 10 && request.resource.data.summary.size() <= 40000
        && request.resource.data.visitedOn is string && request.resource.data.visitedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.correctLocation is bool
        && ((request.resource.data.latitude == null && request.resource.data.longitude == null && request.resource.data.correctLocation == false)
          || (request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180))
        && (request.resource.data.previousLatitude == null || (request.resource.data.previousLatitude is number && request.resource.data.previousLatitude >= -90 && request.resource.data.previousLatitude <= 90))
        && (request.resource.data.previousLongitude == null || (request.resource.data.previousLongitude is number && request.resource.data.previousLongitude >= -180 && request.resource.data.previousLongitude <= 180))
        && request.resource.data.licenseStatus in ['licensed', 'unlicensed', 'unknown']
        && request.resource.data.licenseNumber is string && request.resource.data.licenseNumber.size() <= 480
        && request.resource.data.licenseRegisteredOn is string && request.resource.data.licenseExpiresOn is string
        && (request.resource.data.licenseStatus != 'licensed' || (request.resource.data.licenseNumber.size() > 0
          && request.resource.data.licenseRegisteredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.licenseExpiresOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.licenseExpiresOn >= request.resource.data.licenseRegisteredOn))
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time && request.resource.data.decidedAt == null;
      allow update: if verifiedOwner(resource.data.ownerUid) && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && request.resource.data.status in ['accepted', 'rejected'] && request.resource.data.decidedAt == request.time;
    }
    match /fieldInspectionReports/{id} {
      allow read: if request.auth != null && (resource.data.technicianUid == request.auth.uid || resource.data.get('recipientUid', null) == request.auth.uid || resource.data.clientEmail == request.auth.token.email.lower() || admin());
      allow create: if identifiedFieldTech() && request.resource.data.keys().hasOnly(['clientEmail', 'recipientUid', 'propertyName', 'technicianUid', 'technicianEmail', 'visitedOn', 'summary', 'latitude', 'longitude', 'licenseStatus', 'licenseNumber', 'licenseRegisteredOn', 'licenseExpiresOn', 'ownerUid', 'status', 'createdAt', 'decidedAt'])
        && (request.resource.data.get('recipientUid', null) == null || (request.resource.data.recipientUid is string && request.resource.data.recipientUid != request.auth.uid && request.resource.data.clientEmail == '' && request.resource.data.propertyName == get(/databases/$(database)/documents/propertyDirectory/$(request.resource.data.recipientUid)).data.name))
        && request.resource.data.technicianUid == request.auth.uid && request.resource.data.technicianEmail == request.auth.token.email
        && request.resource.data.clientEmail is string && request.resource.data.clientEmail.size() <= 320 && request.resource.data.clientEmail != request.auth.token.email.lower()
        && request.resource.data.propertyName is string && request.resource.data.propertyName.size() > 0 && request.resource.data.propertyName.size() <= 800
        && request.resource.data.summary is string && request.resource.data.summary.size() >= 10 && request.resource.data.summary.size() <= 40000
        && request.resource.data.visitedOn is string && request.resource.data.visitedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && ((request.resource.data.latitude == null && request.resource.data.longitude == null) || (request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180))
        && request.resource.data.licenseStatus in ['licensed', 'unlicensed', 'unknown'] && request.resource.data.licenseNumber is string && request.resource.data.licenseNumber.size() <= 480
        && request.resource.data.licenseRegisteredOn is string && request.resource.data.licenseExpiresOn is string
        && (request.resource.data.licenseStatus != 'licensed' || (request.resource.data.licenseNumber.size() > 0 && request.resource.data.licenseRegisteredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.licenseExpiresOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.licenseExpiresOn >= request.resource.data.licenseRegisteredOn))
        && request.resource.data.ownerUid == null && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time && request.resource.data.decidedAt == null;
      allow update: if request.auth != null && request.auth.token.email_verified == true && (resource.data.get('recipientUid', null) == request.auth.uid || resource.data.clientEmail == request.auth.token.email.lower()) && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'status', 'decidedAt']) && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status in ['accepted', 'rejected'] && request.resource.data.decidedAt == request.time;
      allow delete: if admin();
    }
    match /technicalNotebooks/{uid}/visits/{id} {
      allow delete: if owner(uid);
      allow read: if owner(uid);
      allow create: if owner(uid) && fieldTech()
        && getAfter(/databases/$(database)/documents/technicalVisits/$(id)).data.technicianUid == uid
        && request.resource.data.keys().hasOnly(['notes', 'createdAt']) && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 40000 && request.resource.data.createdAt == request.time;
    }
    match /technicalNotebooks/{uid}/inspections/{id} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && fieldTech() && getAfter(/databases/$(database)/documents/fieldInspectionReports/$(id)).data.technicianUid == uid
        && request.resource.data.keys().hasOnly(['notes', 'createdAt']) && request.resource.data.notes is string && request.resource.data.notes.size() <= 40000 && request.resource.data.createdAt == request.time;
    }
    match /assistedProducers/{id} {
      function related() { return request.auth != null && (resource.data.technicianUid == request.auth.uid || resource.data.ownerUid == request.auth.uid || supportAuditor()); }
      function validLocation(data) {
        return (data.latitude == null && data.longitude == null) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90 && data.longitude is number && data.longitude >= -180 && data.longitude <= 180);
      }
      allow read: if related();
      allow create: if identifiedFieldTech()
