          && request.resource.data.keys().hasOnly(['enabled', 'actorUid', 'occurredAt', 'noticeVersion'])
          && request.resource.data.enabled is bool && request.resource.data.actorUid == request.auth.uid && request.resource.data.occurredAt == request.time && request.resource.data.noticeVersion == 'regional-offers-v1'
