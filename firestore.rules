    match /adminActivity/{id} {
      allow read: if admin();
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['actorUid','actorEmail','action','collection','entityId','label','occurredAt','revision'])
        && request.resource.data.actorUid == request.auth.uid && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.occurredAt == request.time && request.resource.data.label is string && request.resource.data.label.size() <= 800
        && request.resource.data.entityId is string && request.resource.data.entityId.size() <= 128
        && request.resource.data.revision is int
        && ((request.resource.data.collection in ['licensingCases','environmentalTests'] && request.resource.data.action in ['record.created','record.updated']
