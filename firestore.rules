        && producer().auditStatus == 'approved' && producer().activationCode == code && resource.data.expiresAt > request.time
        && (resource.data.claimedUid == null || resource.data.claimedUid == request.auth.uid);
      allow create: if request.auth != null && code.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['producerId', 'fullName', 'propertyName', 'expiresAt', 'claimedUid', 'claimedAt'])
