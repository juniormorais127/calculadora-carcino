        && value.createdBy is string && value.data is map && value.data.size() <= 150
        && value.data.propertyName is string && value.data.propertyName.size() >= 1 && value.data.propertyName.size() <= 800
        && value.updatedBy == request.auth.uid && value.updatedAt == request.time && value.revision is int
