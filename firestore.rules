        && getAfter(/databases/$(database)/documents/adminActivity/$(value.auditId)).data.actorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/adminActivity/$(value.auditId)).data.collection == kind
        && getAfter(/databases/$(database)/documents/adminActivity/$(value.auditId)).data.entityId == id
        && getAfter(/databases/$(database)/documents/$(kind)/$(id)/history/$(value.auditId)).data.revision == value.revision
        && getAfter(/databases/$(database)/documents/$(kind)/$(id)/history/$(value.auditId)).data.savedBy == request.auth.uid
        && ((kind == 'licensingCases' && value.checklist is map && value.checklist.size() <= 50
          && value.stage in ['draft','documents','review','protocol','analysis','corrections','issued','closed']
          && (value.stage != 'issued' || (value.data.officialLicenseNumber.size() > 0 && value.data.licenseIssuedOn.size() > 0 && value.data.licenseExpiresOn >= value.data.licenseIssuedOn)))
          || (kind == 'environmentalTests' && value.type in ['water','soil','other'] && value.data.parameters is list && value.data.parameters.size() <= 100));
    }
    match /{kind}/{id} {
      allow read: if kind in ['licensingCases','environmentalTests'] && professionalRecordAccess(resource.data);
      allow create: if kind in ['licensingCases','environmentalTests'] && (fieldTech() || admin()) && professionalRecordAccess(request.resource.data)
        && validProfessionalRecord(kind, id) && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.revision == 1
        && (request.resource.data.ownerUid == null || admin() || fieldAccess(request.resource.data.ownerUid));
      allow update: if kind in ['licensingCases','environmentalTests'] && professionalRecordAccess(resource.data) && validProfessionalRecord(kind, id)
        && request.resource.data.technicianUid == resource.data.technicianUid && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.auditId != resource.data.auditId;
      match /history/{eventId} {
        allow read: if kind in ['licensingCases','environmentalTests'] && professionalRecordAccess(get(/databases/$(database)/documents/$(kind)/$(id)).data);
        allow create: if kind in ['licensingCases','environmentalTests'] && professionalRecordAccess(getAfter(/databases/$(database)/documents/$(kind)/$(id)).data)
          && request.resource.data.savedBy == request.auth.uid
          && request.resource.data.diff(getAfter(/databases/$(database)/documents/$(kind)/$(id)).data).affectedKeys().hasOnly(['savedBy'])
