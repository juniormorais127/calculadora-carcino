    function professionalRecordAccess(data) { return request.auth != null && request.auth.token.email_verified == true && (admin() || (fieldTech() && data.technicianUid == request.auth.uid)); }
    function validProfessionalRecord(kind, id) {
      let value = request.resource.data;
      return value.keys().hasOnly(['data', 'stage', 'type', 'checklist', 'technicianUid', 'ownerUid', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'revision', 'auditId'])
