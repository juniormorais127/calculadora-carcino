        && getAfter(/databases/$(database)/documents/assistedProducers/$(request.resource.data.producerId)).data.activationCode == code
        && getAfter(/databases/$(database)/documents/assistedProducers/$(request.resource.data.producerId)).data.fullName == request.resource.data.fullName
        && getAfter(/databases/$(database)/documents/assistedProducers/$(request.resource.data.producerId)).data.propertyName == request.resource.data.propertyName
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(31, 'd')
        && request.resource.data.claimedUid == null && request.resource.data.claimedAt == null;
      allow update: if request.auth != null && request.auth.token.email_verified == true
        && producer().auditStatus == 'approved' && producer().activationCode == code && producer().ownerUid == null && producer().technicianUid != request.auth.uid
        && resource.data.claimedUid == null && resource.data.expiresAt > request.time
