          && request.resource.data.clientDecision in ['accepted', 'rejected'] && request.resource.data.clientDecidedAt == request.time)
        || ((verifiedOwner(resource.data.ownerUid) || (request.auth.token.email_verified == true && (supportAuditor() || (fieldTech() && resource.data.technicianUid == request.auth.uid)) && request.resource.data.marketingConsent == false))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marketingConsent', 'marketingChangedBy', 'marketingChangedAt', 'marketingEventId'])
          && request.resource.data.marketingConsent is bool && request.resource.data.marketingChangedBy == request.auth.uid && request.resource.data.marketingChangedAt == request.time
          && getAfter(/databases/$(database)/documents/assistedProducers/$(id)/consentHistory/$(request.resource.data.marketingEventId)).data.enabled == request.resource.data.marketingConsent
