          && request.resource.data.auditName == get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.fullName
          && request.resource.data.auditNote is string && request.resource.data.auditNote.size() >= 10 && request.resource.data.auditNote.size() <= 8000 && request.resource.data.auditedAt == request.time
          && getAfter(/databases/$(database)/documents/assistedProducers/$(id)/auditHistory/$(request.resource.data.auditEventId)).data.snapshot == resource.data
          && getAfter(/databases/$(database)/documents/assistedProducers/$(id)/auditHistory/$(request.resource.data.auditEventId)).data.status == request.resource.data.auditStatus)
        || (identifiedFieldTech() && resource.data.technicianUid == request.auth.uid && resource.data.auditStatus == 'changes_requested' && resource.data.ownerUid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'email', 'propertyName', 'propertyKey', 'address', 'city', 'state', 'reference', 'latitude', 'longitude', 'presentialConsent', 'marketingConsent', 'initialMarketingConsent', 'marketingChangedBy', 'marketingChangedAt', 'revision', 'auditStatus', 'auditBy', 'auditName', 'auditNote', 'auditedAt', 'auditEventId', 'activationCode', 'activationExpiresAt'])
          && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.auditStatus == 'pending'
          && request.resource.data.auditBy == null && request.resource.data.auditName == '' && request.resource.data.auditNote == '' && request.resource.data.auditedAt == null && request.resource.data.auditEventId == null
          && request.resource.data.fullName is string && (request.resource.data.fullName == '' || (request.resource.data.fullName.size() >= 5 && request.resource.data.fullName.size() <= 800 && request.resource.data.fullName.matches('^.+ .+$')))
          && (request.resource.data.fullName != '' || getAfter(/databases/$(database)/documents/technicalNotebooks/$(request.auth.uid)/assistedClients/$(id)).data.alias.size() >= 2)
          && request.resource.data.phone is string && request.resource.data.phone.matches('^[+][1-9][0-9]{7,14}$')
          && request.resource.data.email is string && request.resource.data.email.size() <= 320
          && request.resource.data.propertyName is string && request.resource.data.propertyName.size() >= 2 && request.resource.data.propertyName.size() <= 800 && request.resource.data.propertyKey == propertyKey(request.resource.data.propertyName)
          && getAfter(/databases/$(database)/documents/propertyNames/$(request.resource.data.propertyKey)).data.sourceId == id
          && request.resource.data.address is string && request.resource.data.address.size() >= 5 && request.resource.data.address.size() <= 2000
          && request.resource.data.city is string && request.resource.data.city.size() >= 2 && request.resource.data.city.size() <= 400
          && request.resource.data.state is string && request.resource.data.state.matches('^(AC|AL|AP|AM|BA|CE|DF|ES|GO|MA|MT|MS|MG|PA|PB|PR|PE|PI|RJ|RN|RS|RO|RR|SC|SP|SE|TO)$')
          && request.resource.data.reference is string && request.resource.data.reference.size() <= 1200 && validLocation(request.resource.data) && request.resource.data.presentialConsent == true
          && request.resource.data.marketingConsent is bool && request.resource.data.initialMarketingConsent == request.resource.data.marketingConsent && request.resource.data.marketingChangedBy == request.auth.uid && request.resource.data.marketingChangedAt == request.time
          && request.resource.data.activationCode != resource.data.activationCode && request.resource.data.activationCode.matches('^[a-f0-9]{32}$')
          && getAfter(/databases/$(database)/documents/assistedActivations/$(request.resource.data.activationCode)).data.producerId == id
          && getAfter(/databases/$(database)/documents/assistedActivations/$(request.resource.data.activationCode)).data.expiresAt == request.resource.data.activationExpiresAt)
        || ((supportAuditor() || (identifiedFieldTech() && resource.data.technicianUid == request.auth.uid)) && resource.data.auditStatus == 'approved' && resource.data.ownerUid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activationCode', 'activationExpiresAt'])
          && request.resource.data.activationCode != resource.data.activationCode && request.resource.data.activationCode.matches('^[a-f0-9]{32}$')
          && getAfter(/databases/$(database)/documents/assistedActivations/$(request.resource.data.activationCode)).data.producerId == id
          && getAfter(/databases/$(database)/documents/assistedActivations/$(request.resource.data.activationCode)).data.expiresAt == request.resource.data.activationExpiresAt)
        || (request.auth.token.email_verified == true && request.auth.uid != resource.data.technicianUid && resource.data.auditStatus == 'approved' && resource.data.ownerUid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'claimedAt']) && request.resource.data.ownerUid == request.auth.uid && request.resource.data.claimedAt == request.time
          && get(/databases/$(database)/documents/assistedActivations/$(resource.data.activationCode)).data.claimedUid == null
          && get(/databases/$(database)/documents/assistedActivations/$(resource.data.activationCode)).data.expiresAt > request.time
          && getAfter(/databases/$(database)/documents/assistedActivations/$(resource.data.activationCode)).data.claimedUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/propertyNames/$(resource.data.propertyKey)).data.ownerUid == request.auth.uid)
